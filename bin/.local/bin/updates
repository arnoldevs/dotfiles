#!/usr/bin/env bash

# =====================================================================
# File: ~/.bashrc.d/updates.sh
# Description: Modular System Maintenance and Application Update Engine
# =====================================================================

# ---------------------------------------------------------------------
# ANSI Formatting & Color Definitions
# ---------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ---------------------------------------------------------------------
# Global Execution Counters
# ---------------------------------------------------------------------
SUCCESS_COUNT=0
TOTAL_COUNT=0

# ---------------------------------------------------------------------
# Logging & Output Helpers
# ---------------------------------------------------------------------
log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; ((SUCCESS_COUNT++)); }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }
log_task()    { echo -e "${PURPLE}  -> Executing:${NC} $1"; }

# ---------------------------------------------------------------------
# Core Privilege & Execution Utilities
# ---------------------------------------------------------------------

# Description: Validates whether the current environment has administrative privileges.
has_sudo() {
    [[ "$EUID" -eq 0 ]] && return 0
    sudo -v 2>/dev/null
    return $?
}

# Description: Executes commands directly if root, otherwise escalates via sudo.
smart_run() {
    if [[ "$EUID" -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

# Description: Synchronizes a local Git repository with its remote upstream via rebase.
update_git_repo() {
    local repo_path="$1"
    log_info "Syncing Git repository at $repo_path..."
    if git -C "$repo_path" pull --rebase; then
        log_success "Repository synchronized successfully."
        return 0
    else
        log_error "Git merge conflict or sync error detected in $(basename "$repo_path")"
        return 1
    fi
}

# ---------------------------------------------------------------------
# User-Space Update Modules (Non-Root Execution)
# ---------------------------------------------------------------------

# Description: Downloads and atomically replaces JetBrainsMono Nerd Font assets.
# Target Directory: ~/.local/share/fonts/JetBrainsMono
nerdfonts_u() {
    local font_dir="$HOME/.local/share/fonts/JetBrainsMono"
    if [[ ! -d "$font_dir" ]]; then
        log_warn "JetBrainsMono Nerd Font directory missing. Skipping update."
        return 0
    fi

    log_info "Updating JetBrainsMono Nerd Font atomically..."
    local temp_dir temp_file temp_path

    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' EXIT
    temp_file="JetBrainsMono.tar.xz"
    temp_path="$temp_dir/$temp_file"

    if curl -L --silent --show-error -o "$temp_path" "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/${temp_file}"; then
        mkdir -p "$temp_dir/extracted"
        if tar -xf "$temp_path" -C "$temp_dir/extracted"; then
            local stage_dir="${font_dir}.tmp"
            rm -rf "$stage_dir"
            mkdir -p "$stage_dir"

            cp -r "$temp_dir/extracted/"* "$stage_dir/"

            # Atomic directory swap
            rm -rf "$font_dir"
            mv "$stage_dir" "$font_dir"

            fc-cache -f
            trap - EXIT
            rm -rf "$temp_dir"
            log_success "JetBrainsMono Nerd Font updated atomically."
            return 0
        fi
    fi

    log_error "Nerd Font update failed."
    trap - EXIT
    rm -rf "$temp_dir"
    return 1
}

# Description: Upgrades Flatpak applications for the current user/system context.
flatpak_u() {
    if command -v flatpak &>/dev/null; then
        log_info "Updating Flatpak runtime packages..."
        if flatpak update -y; then
            log_success "Flatpaks updated successfully."
            return 0
        fi
        log_error "Flatpak update sequence failed."
        return 1
    else
        log_warn "Flatpak executable missing on host. Skipping."
        return 0
    fi
}

# Description: Downloads and performs atomic runtime replacement of Neovim precompiled releases with full system integration.
# Target Directory: ~/.local/opt/nvim
neovim_u() {
    log_info "Updating Neovim release binary and runtime assets..."
    local download_url="https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz"
    local temp_dir temp_path target_dir
    
    target_dir="$HOME/.local/opt/nvim"
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' EXIT
    temp_path="$temp_dir/nvim.tar.gz"

    if curl -L --silent --show-error -o "$temp_path" "$download_url"; then
        local extract_dir="$temp_dir/extracted"
        mkdir -p "$extract_dir"
        
        if tar -xzf "$temp_path" -C "$extract_dir" --strip-components=1; then
            mkdir -p "$target_dir"
            
            # Clean old core files atomically
            rm -rf "${target_dir:?}/"*
            cp -r "$extract_dir/"* "$target_dir/"

            # 1. Symlink for the main executable
            mkdir -p "$HOME/.local/bin"
            ln -sf "$target_dir/bin/nvim" "$HOME/.local/bin/nvim"

            # 2. Clean integration of man pages
            if [[ -d "$target_dir/share/man" ]]; then
                mkdir -p "$HOME/.local/share/man/man1"
                ln -sf "$target_dir/share/man/man1/nvim.1" "$HOME/.local/share/man/man1/nvim.1"
            fi

            # 3. Clean desktop entry and icons integration
            if [[ -f "$target_dir/share/applications/nvim.desktop" ]]; then
                mkdir -p "$HOME/.local/share/applications"
                ln -sf "$target_dir/share/applications/nvim.desktop" "$HOME/.local/share/applications/nvim.desktop"
            fi
            if [[ -d "$target_dir/share/icons" ]]; then
                cp -r "$target_dir/share/icons/"* "$HOME/.local/share/icons/" 2>/dev/null || true
                update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
            fi

            trap - EXIT
            rm -rf "$temp_dir"
            log_success "Neovim updated atomically in $target_dir with full system integration."
            return 0
        fi
    fi

    log_error "Neovim release deployment failed."
    trap - EXIT
    rm -rf "$temp_dir"
    return 1
}

# Description: Fetches and atomically replaces the Beekeeper Studio AppImage executable.
# Target Executable: ~/.local/bin/beekeeper-studio
beekeeper_u() {
    local install_path="$HOME/.local/bin/beekeeper-studio"
    if [[ ! -f "$install_path" ]] && ! command -v beekeeper-studio &>/dev/null; then
        log_warn "Beekeeper Studio missing on host. Skipping update."
        return 0
    fi

    log_info "Resolving Beekeeper Studio AppImage release..."
    mkdir -p "$HOME/.local/bin"

    local api_url="https://api.github.com/repos/beekeeper-studio/beekeeper-studio/releases/latest"
    local release_data
    release_data=$(curl -s --max-time 10 "$api_url")
    
    if [[ -z "$release_data" ]]; then
        log_error "GitHub API request timed out or returned empty response."
        return 1
    fi

    local download_url
    download_url=$(echo "$release_data" | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    for asset in data.get("assets", []):
        url = asset.get("browser_download_url", "")
        if url.endswith(".AppImage") and "arm64" not in url:
            print(url)
            break
except Exception:
    sys.exit(1)
')

    if [[ -z "$download_url" ]]; then
        log_error "Unable to resolve release asset URL for Beekeeper Studio."
        return 1
    fi

    local temp_dir temp_path
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' EXIT
    temp_path="$temp_dir/beekeeper.AppImage"

    if curl -L --silent --show-error --max-time 300 -o "$temp_path" "$download_url"; then
        chmod u+x "$temp_path"

        local old_size=0
        [[ -f "$install_path" ]] && old_size=$(stat -c%s "$install_path" 2>/dev/null || echo 0)
        local new_size=$(stat -c%s "$temp_path")

        if [[ "$old_size" -ne "$new_size" ]]; then
            mv "$temp_path" "$install_path"
            log_success "Beekeeper Studio updated at $install_path"
        else
            log_info "Beekeeper Studio is already up to date."
            ((SUCCESS_COUNT++))
        fi

        trap - EXIT
        rm -rf "$temp_dir"
        return 0
    else
        log_error "Beekeeper Studio download failed or timed out."
        trap - EXIT
        rm -rf "$temp_dir"
        return 1
    fi
}

# Description: Atomically updates the kind (Kubernetes in Docker) CLI tool.
# Target Executable: ~/.local/bin/kind
kind_u() {
    local install_path="$HOME/.local/bin/kind"
    if [[ ! -f "$install_path" ]] && ! command -v kind &>/dev/null; then
        log_warn "kind binary missing on host. Skipping update."
        return 0
    fi

    log_info "Updating kind CLI executable..."
    mkdir -p "$HOME/.local/bin"

    local temp_dir temp_path
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' EXIT
    temp_path="$temp_dir/kind"

    if curl -Lo "$temp_path" --silent --show-error "https://kind.sigs.k8s.io/dl/latest/kind-linux-amd64"; then
        chmod u+x "$temp_path"

        local old_size=0
        [[ -f "$install_path" ]] && old_size=$(stat -c%s "$install_path" 2>/dev/null || echo 0)
        local new_size=$(stat -c%s "$temp_path")

        if [[ "$old_size" -ne "$new_size" ]]; then
            mv "$temp_path" "$install_path"
            log_success "kind binary updated at $install_path"
        else
            log_info "kind binary is already up to date."
            ((SUCCESS_COUNT++))
        fi

        trap - EXIT
        rm -rf "$temp_dir"
        return 0
    else
        log_error "kind binary download failed."
        trap - EXIT
        rm -rf "$temp_dir"
        return 1
    fi
}

# ---------------------------------------------------------------------
# System-Space Update Modules (Root Privileges Required)
# ---------------------------------------------------------------------

# Description: Synchronizes MineGrub theme repository assets and recompiles GRUB configurations.
minegrub_u() {
    local minegrub_dir="$HOME/.custom/minegrub-theme"
    if [[ ! -d "$minegrub_dir" ]]; then
        log_warn "MineGrub directory missing ($minegrub_dir). Skipping update."
        return 0
    fi

    log_info "Updating MineGrub theme repository and assets..."
    update_git_repo "$minegrub_dir" || return 1
    smart_run cp -ruv "$minegrub_dir/minegrub" /boot/grub/themes/
    smart_run grub-mkconfig -o /boot/grub/grub.cfg
    log_success "GRUB configuration and MineGrub theme updated."
    return 0
}

# Description: Triggers firmware upgrades and executes full system APT package updates.
system_u() {
    log_info "Initializing system update sequence..."

    if ! command -v apt &>/dev/null; then
        log_error "APT package manager not detected on host."
        return 1
    fi

    command -v fwupdmgr &>/dev/null && smart_run fwupdmgr update -y 2>/dev/null

    log_info "Executing system APT package upgrade..."
    if smart_run apt update && smart_run apt upgrade -y; then
        log_success "System packages updated successfully."
        return 0
    else
        log_error "APT update cycle encountered errors."
        return 1
    fi
}

# Description: Upgrades the Determinate Nix Engine runtime daemon.
nix_engine_u() {
    if ! command -v determinate-nixd &>/dev/null && [[ ! -x "/usr/local/bin/determinate-nixd" ]] && [[ ! -x "/nix/var/nix/profiles/default/bin/determinate-nixd" ]]; then
        log_warn "determinate-nixd service missing on host. Skipping upgrade."
        return 0
    fi

    log_info "Upgrading Determinate Nix Engine daemon..."
    if smart_run determinate-nixd upgrade; then
        log_success "Determinate Nix Engine upgraded successfully."
        return 0
    else
        log_error "Determinate Nix Engine upgrade failed."
        return 1
    fi
}

# ---------------------------------------------------------------------
# Main Framework Orchestrator
# ---------------------------------------------------------------------

updates() {
    SUCCESS_COUNT=0
    TOTAL_COUNT=0

    local -a updates_user=(neovim_u beekeeper_u kind_u nerdfonts_u flatpak_u)
    local -a updates_sudo=(system_u minegrub_u nix_engine_u)

    info() {
        echo -e "${CYAN}Usage & Options:${NC}"
        echo -e "  -u, --user    Execute user-space updates (~/.local, fonts, Flatpak)"
        echo -e "  -s, --sudo    Execute system-space updates (APT, GRUB, Nix Engine)"
        echo -e "  -a, --all     Run full automated maintenance sequence"
        echo -e "\n${YELLOW}Registered Modules:${NC}"
        for i in "${updates_user[@]}" "${updates_sudo[@]}"; do
            echo "  ${i%_u}"
        done
    }

    run_updates() {
        local type="$1"
        local list_var="updates_$type[@]"
        local list=("${!list_var}")

        if [[ "$type" == "user" && "$EUID" -eq 0 ]]; then
            log_error "Safety Check: Do not run user-space tasks as root."
            return 1
        fi
        if [[ "$type" == "sudo" && "$EUID" -ne 0 ]] && ! has_sudo; then
            log_error "Privilege Escalation Required for system-space tasks."
            return 1
        fi

        echo -e "${PURPLE}=== Starting $type Update Sequence ===${NC}"
        for func in "${list[@]}"; do
            ((TOTAL_COUNT++))
            log_task "${func%_u}"
            "$func" || log_error "Module '${func%_u}' failed."
        done
    }

    [[ "$#" -eq 0 ]] && { info; return 0; }

    case "$1" in
        -u | --user)
            run_updates "user"
            ;;
        -s | --sudo)
            run_updates "sudo"
            ;;
        -a | --all)
            if [[ "$EUID" -eq 0 ]]; then
                run_updates "sudo"
            else
                run_updates "user"
                has_sudo && run_updates "sudo" || log_warn "System sequence skipped due to insufficient privileges."
            fi
            ;;
        -h | --help)
            info
            return 0
            ;;
        *)
            for arg in "$@"; do
                if [[ "$arg" == -* ]]; then
                    log_error "Unknown option: $arg"
                    return 1
                fi
                local func="${arg}_u"
                if declare -f "$func" >/dev/null; then
                    if [[ " ${updates_sudo[*]} " =~ " $func " ]] && [[ "$EUID" -ne 0 ]] && ! has_sudo; then
                        log_error "Task '$arg' requires administrative privileges."
                    else
                        ((TOTAL_COUNT++))
                        "$func" || log_error "Manual task '$arg' failed."
                    fi
                else
                    log_error "Unrecognized task module: $arg"
                    return 1
                fi
            done
            ;;
    esac

    echo -e "\n${CYAN}Maintenance Cycle Summary${NC}"
    echo -e "Tasks attempted: $TOTAL_COUNT | Successful modules: $SUCCESS_COUNT"
}

# Automatically invoke the orchestrator if executed directly as a script
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    updates "$@"
fi
