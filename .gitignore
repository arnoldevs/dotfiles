# --- TEMPORARY FILES & BACKUPS ---
*.bak
*~
*.swp
*.swo
*.tmp

# --- NIX BUILD RESULTS ---
result
result-*

# --- PRIVATE & HOST-SPECIFIC CONFIGURATIONS ---
*.local
# Exception: Do not ignore .local directories required by Stow structure
!**/.local/
*.local.*
**/.bashrc.local
**/*.local.sh

# --- DYNAMIC & RUNTIME GENERATED THEMES ---
# Bash
bash/.bashrc.d/colors.sh

# Kitty (Using ** to match whether it's in 'archive/' or a future 'kitty/' stow package)
**/kitty/current-theme.conf
**/kitty/theme.conf
**/kitty/**/*.bak

# Sway
**/sway/config.d/90-sway-colors.conf

# Cava
cava/.config/cava/shaders/

# --- OS GENERATED FILES ---
.DS_Store
Thumbs.db
